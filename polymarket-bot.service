[Unit]
Description=Polymarket Agent Team Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orlovrp
WorkingDirectory=/home/orlovrp/polymarket-bot
ExecStart=/home/orlovrp/polymarket-bot/venv/bin/python main.py
EnvironmentFile=/home/orlovrp/polymarket-bot/.env
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5
KillMode=mixed
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-bot

[Install]
WantedBy=multi-user.target
