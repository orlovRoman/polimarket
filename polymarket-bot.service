[Unit]
Description=Polymarket Agent Team Bot
After=network-online.target
Requires=network-online.target

[Service]
Type=simple
User=orlovrp
WorkingDirectory=/home/orlovrp/polymarket-bot
ExecStart=/home/orlovrp/polymarket-bot/venv/bin/python main.py
EnvironmentFile=/home/orlovrp/polymarket-bot/.env
Restart=always
RestartSec=30
StartLimitIntervalSec=0
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-bot

[Install]
WantedBy=multi-user.target
