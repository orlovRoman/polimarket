[Unit]
# Описание сервиса: Real-time слушатель крупных сделок из Telegram для Polymarket
Description=Polymarket Telegram Whale Alert Listener
# Запускать только после того, как сеть станет доступна
After=network.target

[Service]
Type=simple
# Имя пользователя, под которым будет работать сервис
User=orlovrp
# Рабочая директория проекта
WorkingDirectory=/home/orlovrp/polymarket-bot
# Принудительный сброс буфера вывода Python для мгновенного логирования в journald
Environment=PYTHONUNBUFFERED=1
# Команда запуска с использованием виртуального окружения
ExecStart=/home/orlovrp/polymarket-bot/venv/bin/python3 services/telegram_listener.py
# Перезапускать сервис автоматически при сбое (не перезапускать при штатном выходе)
Restart=on-failure
# Пауза перед перезапуском (10 секунд)
RestartSec=10
# Логирование вывода в системный журнал journald
StandardOutput=journal
StandardError=journal

[Install]
# Уровень запуска для автозагрузки
WantedBy=multi-user.target
