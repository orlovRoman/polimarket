# -----------------------------------------------------------------------------
# Polymarket Agent Team Bot - Environment Variables Template
# -----------------------------------------------------------------------------
# Скопируйте этот файл в .env и заполните значения ключами.
# НЕ КОММИТЬТЕ реальный файл .env в систему контроля версий.

# === [ОБЯЗАТЕЛЬНО] API ключи и токены ===
GOOGLE_API_KEY="your_google_gemini_api_key_here"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here" # Основной чат для уведомлений

# === [ДОПОЛНИТЕЛЬНО] Резервные API ключи Gemini (для ротации при лимитах) ===
GOOGLE_API_KEY_SECONDARY=""
GOOGLE_API_KEY_THIRD=""

# === [ДОПОЛНИТЕЛЬНО] Настройки Telethon (для прослушивания Telegram каналов) ===
TG_API_ID=""
TG_API_HASH=""
TG_PHONE=""

# === [ДОПОЛНИТЕЛЬНО] Настройки второй группы (Event-driven) ===
TELEGRAM_BOT_ID=""
TELEGRAM_GROUP2_SOURCE="group2_source"
TELEGRAM_GROUP2_TARGET_ID=""

# === Настройки путей ===
# VAULT_PATH="./vault"
# DB_PATH="./vault/database.sqlite"

# === Параметры сканирования и фильтрации рынков ===
# SCAN_LIMIT=30
# MIN_EDGE=0.05
# MARKET_COOLDOWN_HOURS=4
# MARKET_OFFSET_MAX=200
# PRICE_RANGE_MIN=0.10
# PRICE_RANGE_MAX=0.90
# MAX_SCREENING_MARKETS=120
# POLY_EVENTS_CACHE_TTL=300

# === Настройки памяти и лимитов ===
# MEMORY_FACTS_LIMIT=30

# === Whale Alert & Whale Gate ===
# WHALE_ALERT_MIN_USD=10000
# WHALE_GATE_MIN_CONFIDENCE=0.5
# WHALE_GATE_MIN_COUNT=2

# === Настройки арбитража ===
# ARB_POLY_LIMIT=100
# ARB_KALSHI_LIMIT=100
# ARB_MIN_MATCH_SCORE=0.50
# ARB_MIN_SPREAD_ALERT=5.0
# ARB_MAX_DAYS_DIFF=30
# CORRIDOR_BUDGET_PER_TRADE=200.0

# === Настройки веб-дашборда ===
# DASHBOARD_PORT=8050


