# -----------------------------------------------------------------------------
# Polymarket Agent Team Bot - Environment Variables Template
# -----------------------------------------------------------------------------
# Скопируйте этот файл в .env и заполните значения ключами.
# НЕ КОММИТЬТЕ реальный файл .env в систему контроля версий.

# [ОБЯЗАТЕЛЬНО] API-ключ Gemini для работы агентов
GEMINI_API_KEY="your_google_gemini_api_key_here"

# [ОБЯЗАТЕЛЬНО] Токен Telegram-бота для отправки уведомлений
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# [ДОПОЛНИТЕЛЬНО] Настройки логирования и другие переменные, если нужны
# LOG_LEVEL="INFO"
